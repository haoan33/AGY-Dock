{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AGY Dock",
  "mainBinaryName": "AGY Dock",
  "version": "2.10.0",
  "identifier": "xyz.ahmustudyhelper.agy-plugin-manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AGY Dock",
        "width": 1120,
        "height": 730,
        "minWidth": 880,
        "minHeight": 580,
        "resizable": true,
        "fullscreen": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "../AGY-Launcher/plugins.example.json": "plugins.example.json"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "nsis/hooks.nsh"
      }
    }
  }
}
